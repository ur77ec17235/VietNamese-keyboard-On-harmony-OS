{
  "module": {
    "name": "Stage",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "StageAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "StageAbility",
        "srcEntry": "./ets/stageability/StageAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:logo",
        "label": "$string:app_name",
        "startWindowIcon": "$media:logo",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "GoTiengVietService",
        "srcEntry": "./ets/telex/service/GoTiengVietService.ets",
        "description": "$string:service_desc",
        "icon": "$media:logo",
        "label": "$string:app_name",
        "type": "inputMethod",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.inputmethod"
            ],
            "actions": [
              "action.system.inputmethod"
            ]
          }
        ],
        "metadata": [
          {
            "name": "ohos.extension.input_method",
            "resource": "$profile:input_method_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:permission_reason_microphone",
        "usedScene": {
          "abilities": ["StageAbility", "GoTiengVietService"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:permission_reason_network",
        "usedScene": {
          "abilities": ["StageAbility", "GoTiengVietService"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:permission_reason_clipboard",
        "usedScene": {
          "abilities": ["GoTiengVietService"],
          "when": "inuse"
        }
      }
    ]
  }
}
